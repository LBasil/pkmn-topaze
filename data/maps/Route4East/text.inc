@ ---- TRAINERS (route4e_trainers.py)

Route4East_Text_MarcoIntro::
    .string "I climbed the whole MT. MOON\nflank. This trail is easy!$"

Route4East_Text_MarcoDefeat::
    .string "My legs are fine.\nMy POKéMON, less so.$"

Route4East_Text_MarcoPostBattle::
    .string "The dust turns to moss further\neast. That is where the\p"
    .string "TOURMALINE starts to grow.$"

Route4East_Text_TessaIntro::
    .string "The ground sparkles here!\nIt's moon dust, you know.$"

Route4East_Text_TessaDefeat::
    .string "Oh no, my sparkles!$"

Route4East_Text_TessaPostBattle::
    .string "CLEFAIRY dance in the moon dust\nwhen the sky is clear.$"

Route4East_Text_LeoIntro::
    .string "Camping here is great. No one\nbothers you, except TRAINERS!$"

Route4East_Text_LeoDefeat::
    .string "You ruined my evening.$"

Route4East_Text_LeoPostBattle::
    .string "The trees get thicker toward the\ncrystals. Watch your step.$"

Route4East_Text_NinaIntro::
    .string "These crystals sing when the\nwind blows. Listen!$"

Route4East_Text_NinaDefeat::
    .string "You broke my concentration!$"

Route4East_Text_NinaPostBattle::
    .string "TOURMALIA is just ahead. Its\nhouses are built in the trees.$"

Route4East_Text_RioIntro::
    .string "Bugs are different since the\nAURA. Check their types!$"

Route4East_Text_RioDefeat::
    .string "My bugs are special!$"

Route4East_Text_RioPostBattle::
    .string "CATERPIE is PSYCHIC now.\nWEEDLE is ELECTRIC.\p"
    .string "Mind its sting.$"
