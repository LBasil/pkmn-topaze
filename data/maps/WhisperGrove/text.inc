WhisperGrove_Text_ReturnAsk::
	.string "Ready to go back to the dock?$"

WhisperGrove_Text_Stay::
	.string "Take your time. The tide can wait.$"

WhisperGrove_Text_Npc0::
	.string "Listen. The trees whisper names of\n"
	.string "those who passed.$"

WhisperGrove_Text_Npc1::
	.string "MISDREAVUS sings at night. Do not\n"
	.string "sing back.$"

WhisperGrove_Text_Quest0_Ask::
	.string "A NUGGET pays the ferryman for a\n"
	.string "lost soul. Bring me one.$"

WhisperGrove_Text_Quest0_Done::
	.string "The soul rests. Take this SPELL\n"
	.string "TAG.$"

WhisperGrove_Text_Quest0_AfterT::
	.string "The grove is quieter now.$"

WhisperGrove_Text_Quest0_MissT::
	.string "No NUGGET yet. Look on the routes.$"

WhisperGrove_Text_Quest0_NoRoomT::
	.string "Your BAG is full. Make room, then\n"
	.string "come back.$"

