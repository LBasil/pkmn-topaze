Route18_EastEntrance_2F_MapScripts::
	.byte 0

Route18_EastEntrance_2F_EventScript_LeftBinoculars::
	msgbox Route18_EastEntrance_2F_Text_PalletTownInWest, MSGBOX_SIGN
	end

Route18_EastEntrance_2F_EventScript_RightBinoculars::
	msgbox Route18_EastEntrance_2F_Text_PeopleSwimming, MSGBOX_SIGN
	end

Route18_EastEntrance_2F_EventScript_Haden::
	lock
	faceplayer
	goto_if_set FLAG_DID_MARC_TRADE, Route18_EastEntrance_2F_EventScript_Haden_Done
	msgbox Route18_EastEntrance_2F_Text_QuestAsk
	setvar VAR_0x8004, 1
	specialvar VAR_RESULT, GetPokedexCount
	buffernumberstring STR_VAR_1, VAR_0x8006
	goto_if_lt VAR_0x8006, 80, Route18_EastEntrance_2F_EventScript_Haden_No
	checkitemspace ITEM_PRISM_SCALE
	goto_if_eq VAR_RESULT, FALSE, Route18_EastEntrance_2F_EventScript_Haden_NoRoom
	msgbox Route18_EastEntrance_2F_Text_QuestOk
	giveitem_msg Route18_EastEntrance_2F_Text_QuestGot, ITEM_PRISM_SCALE
	setflag FLAG_DID_MARC_TRADE
	release
	end

Route18_EastEntrance_2F_EventScript_Haden_No::
	msgbox Route18_EastEntrance_2F_Text_QuestNo
	release
	end

Route18_EastEntrance_2F_EventScript_Haden_NoRoom::
	msgbox Route18_EastEntrance_2F_Text_QuestNoRoom
	release
	end

Route18_EastEntrance_2F_EventScript_Haden_Done::
	msgbox Route18_EastEntrance_2F_Text_QuestDone
	release
	end
