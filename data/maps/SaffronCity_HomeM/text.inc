SaffronCity_HomeM_Text_Intro::
	.string "This is the TRIAL TOWER. Five\n"
	.string "rivals, back to back, no healing\p"
	.string "between rounds. Ready to race the\n"
	.string "clock?$"

SaffronCity_HomeM_Text_Go::
	.string "Then begin. SECOND is first.$"

SaffronCity_HomeM_Text_Beat1::
	.string "Too slow...$"

SaffronCity_HomeM_Text_Beat2::
	.string "A minute is not enough.$"

SaffronCity_HomeM_Text_Beat3::
	.string "An hour well spent... for you.$"

SaffronCity_HomeM_Text_Beat4::
	.string "The day is yours.$"

SaffronCity_HomeM_Text_Beat5::
	.string "A whole year lost to you...$"

SaffronCity_HomeM_Text_Clear::
	.string "All five down! Time itself bows to\n"
	.string "you. Take these as proof.$"

SaffronCity_HomeM_Text_Early::
	.string "Not yet. Come back with all 8\n"
	.string "BADGES.$"

SaffronCity_HomeM_Text_Decline::
	.string "Time waits for no one. But I will.$"

SaffronCity_HomeM_Text_NoRoom::
	.string "Your BAG is full. Make room, then\n"
	.string "come back.$"
