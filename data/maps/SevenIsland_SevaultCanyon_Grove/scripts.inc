SevenIsland_SevaultCanyon_Grove_MapScripts::
	map_script MAP_SCRIPT_ON_TRANSITION, SevenIsland_SevaultCanyon_Grove_OnTransition
	map_script MAP_SCRIPT_ON_WARP_INTO_MAP_TABLE, SevenIsland_SevaultCanyon_Grove_OnWarp
	.byte 0

SevenIsland_SevaultCanyon_Grove_OnTransition::
	setflag FLAG_TEMP_11
	setflag FLAG_TEMP_14
	setflag FLAG_TEMP_1E
	setflag FLAG_TEMP_1F
	setflag FLAG_HIDE_ECHO_SCENE
	setflag FLAG_HIDE_ECHO_KYOGRE
	call_if_unset FLAG_DONE_ECHO_KYOGRE, SevenIsland_SevaultCanyon_EventScript_MaybeKyogre
	setflag FLAG_HIDE_ECHO_GROUDON
	call_if_unset FLAG_DONE_ECHO_GROUDON, SevenIsland_SevaultCanyon_EventScript_MaybeGroudon
	setflag FLAG_HIDE_ECHO_RAYQUAZA
	call_if_unset FLAG_DONE_ECHO_RAYQUAZA, SevenIsland_SevaultCanyon_EventScript_MaybeRayquaza
	setflag FLAG_HIDE_ECHO_LATIAS
	call_if_unset FLAG_DONE_ECHO_LATIAS, SevenIsland_SevaultCanyon_EventScript_MaybeLatias
	setflag FLAG_HIDE_ECHO_LATIOS
	call_if_unset FLAG_DONE_ECHO_LATIOS, SevenIsland_SevaultCanyon_EventScript_MaybeLatios
	setflag FLAG_HIDE_ECHO_JIRACHI
	call_if_unset FLAG_DONE_ECHO_JIRACHI, SevenIsland_SevaultCanyon_EventScript_MaybeJirachi
	call_if_eq VAR_ECHO_STAGE, 22, SevenIsland_SevaultCanyon_EventScript_ShowWardens
	end

SevenIsland_SevaultCanyon_Grove_OnWarp::
	map_script_2 VAR_TEMP_0, 0, SevenIsland_SevaultCanyon_Grove_Arrive
	.2byte 0

@ arrival on the exit-warp tile: step one tile inward so the player can walk back out (re-trigger the warp)
SevenIsland_SevaultCanyon_Grove_Arrive::
	getplayerxy VAR_0x8004, VAR_0x8005
	goto_if_ne VAR_0x8004, 7, SevenIsland_SevaultCanyon_Grove_ArriveEnd
	goto_if_eq VAR_0x8005, 13, SevenIsland_SevaultCanyon_Grove_StepUp
SevenIsland_SevaultCanyon_Grove_ArriveEnd::
	end

SevenIsland_SevaultCanyon_Grove_StepUp::
	applymovement OBJ_EVENT_ID_PLAYER, SevenIsland_SevaultCanyon_Grove_Movement_In
	waitmovement 0
	end

SevenIsland_SevaultCanyon_Grove_Movement_In::
	walk_up
	step_end
