ClockBeach_Text_ReturnAsk::
	.string "Ready to go back to the dock?$"

ClockBeach_Text_Stay::
	.string "Take your time. The tide can wait.$"

ClockBeach_Text_Boss_Intro::
	.string "Another stopped clock washed up:\n"
	.string "you. Let the sea decide how long\p"
	.string "you stay!$"

ClockBeach_Text_Boss_Defeat::
	.string "The tide turned for you.$"

ClockBeach_Text_Boss_After::
	.string "The sea keeps what it likes. Today\n"
	.string "it kept nothing of yours.$"

ClockBeach_Text_Boss_NoRoom::
	.string "Your BAG is full. Make room, then\n"
	.string "come back.$"

ClockBeach_Text_Npc0::
	.string "A clock washed up at dawn. Another\n"
	.string "at noon. They all say 3:07.$"

ClockBeach_Text_Npc1::
	.string "I found a shell shaped like a\n"
	.string "clock. It ticks when it rains.$"
