	end

PokemonLeague_LoreleisRoom_OnFrame::
	map_script_2 VAR_TEMP_E, 0, PokemonLeague_LoreleisRoom_EventScript_BossRetry
	map_script_2 VAR_MAP_SCENE_POKEMON_LEAGUE, 0, PokemonLeague_LoreleisRoom_EventScript_EnterRoom
	.2byte 0

@ Topaze: after losing to the boss, offer to go straight back to him (no need to redo the tournament)
PokemonLeague_LoreleisRoom_EventScript_BossRetry::
	setvar VAR_TEMP_E, 1
	goto_if_unset FLAG_TOPAZE_BOSS_RETRY, PokemonLeague_LoreleisRoom_EventScript_BossRetryNo
	goto_if_defeated TRAINER_LEAGUE_BOSS_2, PokemonLeague_LoreleisRoom_EventScript_BossRetryNo
	lockall
	textcolor NPC_TEXT_COLOR_NEUTRAL
	msgbox PokemonLeague_LoreleisRoom_Text_BossRetry, MSGBOX_YESNO
	goto_if_eq VAR_RESULT, NO, PokemonLeague_LoreleisRoom_EventScript_BossRetryDecline
	closemessage
	special HealPlayerParty
	setvar VAR_TEMP_1, 0
	warp MAP_POKEMON_LEAGUE_CHAMPIONS_ROOM, 6, 19
	waitstate
	releaseall
	end

PokemonLeague_LoreleisRoom_EventScript_BossRetryDecline::
	releaseall
	end

PokemonLeague_LoreleisRoom_EventScript_BossRetryNo::
	end

PokemonLeague_LoreleisRoom_EventScript_EnterRoom::
	lockall
	goto_if_set FLAG_TOPAZE_COUNCIL, PokemonLeague_LoreleisRoom_EventScript_EnterRoomOpen
	call PokemonLeague_EventScript_EnterRoom
	setvar VAR_MAP_SCENE_POKEMON_LEAGUE, 1
	releaseall
	end

@ Topaze: post-game, the entry does not close behind the player (the Council of Elders is optional)
PokemonLeague_LoreleisRoom_EventScript_EnterRoomOpen::
	applymovement LOCALID_PLAYER, Common_Movement_WalkUp5
	waitmovement 0
	setflag FLAG_TEMP_2
	call PokemonLeague_LoreleisRoom_EventScript_OpenEntry
	special DrawWholeMapView
	setvar VAR_MAP_SCENE_POKEMON_LEAGUE, 1
	releaseall
	end

PokemonLeague_LoreleisRoom_EventScript_Lorelei::
	lock
	faceplayer
	goto_if_set FLAG_TOPAZE_COUNCIL, PokemonLeague_LoreleisRoom_EventScript_ElderMatch
	famechecker FAMECHECKER_LORELEI, FCPICKSTATE_COLORED, UpdatePickStateFromSpecialVar8005
	goto_if_set FLAG_DEFEATED_LORELEI, PokemonLeague_LoreleisRoom_EventScript_PostBattle
	goto_if_lt VAR_TOURNAMENT_ROUND, 9, PokemonLeague_LoreleisRoom_EventScript_TournamentMatch
	famechecker FAMECHECKER_LORELEI, 0
	famechecker FAMECHECKER_LORELEI, 1
	call_if_unset FLAG_SYS_CAN_LINK_WITH_RS, PokemonLeague_LoreleisRoom_EventScript_Intro
	call_if_set FLAG_SYS_CAN_LINK_WITH_RS, PokemonLeague_LoreleisRoom_EventScript_RematchIntro
	setflag FLAG_TEMP_3
	setflag FLAG_TEMP_5
	call_if_unset FLAG_SYS_CAN_LINK_WITH_RS, PokemonLeague_LoreleisRoom_EventScript_Battle
	call_if_set FLAG_SYS_CAN_LINK_WITH_RS, PokemonLeague_LoreleisRoom_EventScript_Rematch
	clearflag FLAG_TEMP_5
	goto PokemonLeague_LoreleisRoom_EventScript_DefeatedLorelei
	end

