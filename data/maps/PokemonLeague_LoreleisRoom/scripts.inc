	map_script MAP_SCRIPT_ON_FRAME_TABLE, PokemonLeague_LoreleisRoom_OnFrame
	.byte 0

PokemonLeague_LoreleisRoom_OnResume::
	setvar VAR_0x8004, 0
	call PokemonLeague_EventScript_DoLightingEffect
	end

PokemonLeague_LoreleisRoom_OnLoad::
	call_if_set FLAG_DEFEATED_LORELEI, PokemonLeague_LoreleisRoom_EventScript_SetDoorOpen
	call_if_eq VAR_MAP_SCENE_POKEMON_LEAGUE, 1, PokemonLeague_LoreleisRoom_EventScript_CloseEntry
	end

PokemonLeague_LoreleisRoom_EventScript_CloseEntry::
	@ Topaze : en post-game (Conseil des Anciens, facultatif) l'entree reste ouverte, sinon le joueur est enferme dans la salle
	goto_if_set FLAG_TOPAZE_COUNCIL, PokemonLeague_LoreleisRoom_EventScript_OpenEntry
	call PokemonLeague_EventScript_CloseEntry
	return

@ La mise en page d'origine pose la collision sur toute l'entree (le joueur n'y marche que par script) : on la retire sur la colonne du milieu.
@ Post-game : la case d'entree n'a pas de comportement de warp -> on sort par declencheur (sinon l'entree ouverte ne mene nulle part)
PokemonLeague_LoreleisRoom_EventScript_ExitRoom::
	lockall
	goto_if_unset FLAG_TOPAZE_COUNCIL, PokemonLeague_LoreleisRoom_EventScript_ExitRoomEnd
	warp MAP_INDIGO_PLATEAU_POKEMON_CENTER_1F, 4, 2
	waitstate
PokemonLeague_LoreleisRoom_EventScript_ExitRoomEnd::
	releaseall
	end

PokemonLeague_LoreleisRoom_EventScript_OpenEntry::
	setmetatile 6, 11, 0x29B, 0
	setmetatile 6, 12, 0x2A3, 0
	return

PokemonLeague_LoreleisRoom_EventScript_SetDoorOpen::
	call PokemonLeague_EventScript_SetDoorOpen
	return

PokemonLeague_LoreleisRoom_OnTransition::
	setworldmapflag FLAG_WORLD_MAP_POKEMON_LEAGUE_LORELEIS_ROOM
	call PokemonLeague_LoreleisRoom_EventScript_SetOpponentGfx
	end

