PokemonLeague_LoreleisRoom_MapScripts::
	map_script MAP_SCRIPT_ON_RESUME, PokemonLeague_LoreleisRoom_OnResume
	map_script MAP_SCRIPT_ON_LOAD, PokemonLeague_LoreleisRoom_OnLoad
	map_script MAP_SCRIPT_ON_TRANSITION, PokemonLeague_LoreleisRoom_OnTransition
	map_script MAP_SCRIPT_ON_WARP_INTO_MAP_TABLE, PokemonLeague_LoreleisRoom_OnWarp
	map_script MAP_SCRIPT_ON_FRAME_TABLE, PokemonLeague_LoreleisRoom_OnFrame
	.byte 0

PokemonLeague_LoreleisRoom_OnResume::
	setvar VAR_0x8004, 0
	call PokemonLeague_EventScript_DoLightingEffect
	end

PokemonLeague_LoreleisRoom_OnLoad::
	call_if_set FLAG_DEFEATED_LORELEI, PokemonLeague_LoreleisRoom_EventScript_SetDoorOpen
	call_if_eq VAR_MAP_SCENE_POKEMON_LEAGUE, 1, PokemonLeague_LoreleisRoom_EventScript_CloseEntry
	end

PokemonLeague_LoreleisRoom_EventScript_CloseEntry::
	call PokemonLeague_EventScript_CloseEntry
	return

PokemonLeague_LoreleisRoom_EventScript_SetDoorOpen::
	call PokemonLeague_EventScript_SetDoorOpen
	return

PokemonLeague_LoreleisRoom_OnTransition::
	setworldmapflag FLAG_WORLD_MAP_POKEMON_LEAGUE_LORELEIS_ROOM
	call PokemonLeague_LoreleisRoom_EventScript_SetOpponentGfx
	end

@ Topaze: the first hall is the tournament arena (9 matches, VAR_TOURNAMENT_ROUND 0-8)
PokemonLeague_LoreleisRoom_EventScript_SetOpponentGfx::
	setvar VAR_OBJ_GFX_ID_0, OBJ_EVENT_GFX_SCIENTIST
	goto_if_eq VAR_TOURNAMENT_ROUND, 0, PokemonLeague_LoreleisRoom_EventScript_GfxDone
	setvar VAR_OBJ_GFX_ID_0, OBJ_EVENT_GFX_RS_MAY
	goto_if_eq VAR_TOURNAMENT_ROUND, 1, PokemonLeague_LoreleisRoom_EventScript_GfxDone
	setvar VAR_OBJ_GFX_ID_0, OBJ_EVENT_GFX_RS_BRENDAN
	goto_if_eq VAR_TOURNAMENT_ROUND, 2, PokemonLeague_LoreleisRoom_EventScript_GfxDone
	setvar VAR_OBJ_GFX_ID_0, OBJ_EVENT_GFX_COOLTRAINER_M
	goto_if_eq VAR_TOURNAMENT_ROUND, 3, PokemonLeague_LoreleisRoom_EventScript_GfxDone
	setvar VAR_OBJ_GFX_ID_0, OBJ_EVENT_GFX_COOLTRAINER_F
	goto_if_eq VAR_TOURNAMENT_ROUND, 4, PokemonLeague_LoreleisRoom_EventScript_GfxDone
	setvar VAR_OBJ_GFX_ID_0, OBJ_EVENT_GFX_BEAUTY
	goto_if_eq VAR_TOURNAMENT_ROUND, 5, PokemonLeague_LoreleisRoom_EventScript_GfxDone
	setvar VAR_OBJ_GFX_ID_0, OBJ_EVENT_GFX_BLUE
	goto_if_eq VAR_TOURNAMENT_ROUND, 6, PokemonLeague_LoreleisRoom_EventScript_GfxDone
	setvar VAR_OBJ_GFX_ID_0, OBJ_EVENT_GFX_BLUE
	goto_if_eq VAR_TOURNAMENT_ROUND, 7, PokemonLeague_LoreleisRoom_EventScript_GfxDone
	setvar VAR_OBJ_GFX_ID_0, OBJ_EVENT_GFX_GENTLEMAN
PokemonLeague_LoreleisRoom_EventScript_GfxDone::
	return

PokemonLeague_LoreleisRoom_OnWarp::
	map_script_2 VAR_TEMP_1, 0, PokemonLeague_LoreleisRoom_EventScript_TurnPlayerNorth
	.2byte 0

PokemonLeague_LoreleisRoom_EventScript_TurnPlayerNorth::
	turnobject LOCALID_PLAYER, DIR_NORTH
	end

PokemonLeague_LoreleisRoom_OnFrame::
	map_script_2 VAR_MAP_SCENE_POKEMON_LEAGUE, 0, PokemonLeague_LoreleisRoom_EventScript_EnterRoom
	.2byte 0

PokemonLeague_LoreleisRoom_EventScript_EnterRoom::
	lockall
	call PokemonLeague_EventScript_EnterRoom
	setvar VAR_MAP_SCENE_POKEMON_LEAGUE, 1
	releaseall
	end

PokemonLeague_LoreleisRoom_EventScript_Lorelei::
	lock
	faceplayer
	famechecker FAMECHECKER_LORELEI, FCPICKSTATE_COLORED, UpdatePickStateFromSpecialVar8005
	goto_if_set FLAG_DEFEATED_LORELEI, PokemonLeague_LoreleisRoom_EventScript_PostBattle
	goto_if_lt VAR_TOURNAMENT_ROUND, 9, PokemonLeague_LoreleisRoom_EventScript_TournamentMatch
	famechecker FAMECHECKER_LORELEI, 0
	famechecker FAMECHECKER_LORELEI, 1
	call_if_unset FLAG_SYS_CAN_LINK_WITH_RS, PokemonLeague_LoreleisRoom_EventScript_Intro
	call_if_set FLAG_SYS_CAN_LINK_WITH_RS, PokemonLeague_LoreleisRoom_EventScript_RematchIntro
	setflag FLAG_TEMP_3
	setflag FLAG_TEMP_5
	call_if_unset FLAG_SYS_CAN_LINK_WITH_RS, PokemonLeague_LoreleisRoom_EventScript_Battle
	call_if_set FLAG_SYS_CAN_LINK_WITH_RS, PokemonLeague_LoreleisRoom_EventScript_Rematch
	clearflag FLAG_TEMP_5
	goto PokemonLeague_LoreleisRoom_EventScript_DefeatedLorelei
	end

PokemonLeague_LoreleisRoom_EventScript_Intro::
	msgbox PokemonLeague_LoreleisRoom_Text_Intro
	return

PokemonLeague_LoreleisRoom_EventScript_RematchIntro::
	msgbox PokemonLeague_LoreleisRoom_Text_RematchIntro
	return

PokemonLeague_LoreleisRoom_EventScript_Battle::
	trainerbattle_no_intro TRAINER_ELITE_FOUR_LORELEI, PokemonLeague_LoreleisRoom_Text_Defeat
	return

PokemonLeague_LoreleisRoom_EventScript_Rematch::
	trainerbattle_no_intro TRAINER_ELITE_FOUR_LORELEI_2, PokemonLeague_LoreleisRoom_Text_Defeat
	return

PokemonLeague_LoreleisRoom_EventScript_PostBattle::
	msgbox PokemonLeague_LoreleisRoom_Text_PostBattle
	release
	end

PokemonLeague_LoreleisRoom_EventScript_DefeatedLorelei::
	setflag FLAG_DEFEATED_LORELEI
	call PokemonLeague_EventScript_OpenDoor
	msgbox PokemonLeague_LoreleisRoom_Text_PostBattle
	release
	end

PokemonLeague_LoreleisRoom_EventScript_TournamentMatch::
	switch VAR_TOURNAMENT_ROUND
	case 0, PokemonLeague_LoreleisRoom_EventScript_Round0
	case 1, PokemonLeague_LoreleisRoom_EventScript_Round1
	case 2, PokemonLeague_LoreleisRoom_EventScript_Round2
	case 3, PokemonLeague_LoreleisRoom_EventScript_Round3
	case 4, PokemonLeague_LoreleisRoom_EventScript_Round4
	case 5, PokemonLeague_LoreleisRoom_EventScript_Round5
	case 6, PokemonLeague_LoreleisRoom_EventScript_Round6
	case 7, PokemonLeague_LoreleisRoom_EventScript_Round7
	case 8, PokemonLeague_LoreleisRoom_EventScript_Round8
	release
	end

PokemonLeague_LoreleisRoom_EventScript_Round0::
	msgbox PokemonLeague_LoreleisRoom_Text_Round0Intro
	trainerbattle_no_intro TRAINER_LEAGUE_SEKO, PokemonLeague_LoreleisRoom_Text_Round0Defeat
	setvar VAR_TOURNAMENT_ROUND, 1
	goto PokemonLeague_LoreleisRoom_EventScript_NextMatch
	end

PokemonLeague_LoreleisRoom_EventScript_Round1::
	msgbox PokemonLeague_LoreleisRoom_Text_Round1Intro
	trainerbattle_no_intro TRAINER_LEAGUE_MAY, PokemonLeague_LoreleisRoom_Text_Round1Defeat
	setvar VAR_TOURNAMENT_ROUND, 2
	goto PokemonLeague_LoreleisRoom_EventScript_NextMatch
	end

PokemonLeague_LoreleisRoom_EventScript_Round2::
	msgbox PokemonLeague_LoreleisRoom_Text_Round2Intro
	trainerbattle_no_intro TRAINER_LEAGUE_BRENDAN, PokemonLeague_LoreleisRoom_Text_Round2Defeat
	setvar VAR_TOURNAMENT_ROUND, 3
	goto PokemonLeague_LoreleisRoom_EventScript_NextMatch
	end

PokemonLeague_LoreleisRoom_EventScript_Round3::
	msgbox PokemonLeague_LoreleisRoom_Text_Round3Intro
	trainerbattle_no_intro TRAINER_LEAGUE_GOLD, PokemonLeague_LoreleisRoom_Text_Round3Defeat
	setvar VAR_TOURNAMENT_ROUND, 4
	goto PokemonLeague_LoreleisRoom_EventScript_NextMatch
	end

PokemonLeague_LoreleisRoom_EventScript_Round4::
	msgbox PokemonLeague_LoreleisRoom_Text_Round4Intro
	trainerbattle_no_intro TRAINER_LEAGUE_CRYSTAL, PokemonLeague_LoreleisRoom_Text_Round4Defeat
	setvar VAR_TOURNAMENT_ROUND, 5
	goto PokemonLeague_LoreleisRoom_EventScript_NextMatch
	end

PokemonLeague_LoreleisRoom_EventScript_Round5::
	msgbox PokemonLeague_LoreleisRoom_Text_Round5Intro
	trainerbattle_no_intro TRAINER_LEAGUE_LEAF, PokemonLeague_LoreleisRoom_Text_Round5Defeat
	setvar VAR_TOURNAMENT_ROUND, 6
	goto PokemonLeague_LoreleisRoom_EventScript_NextMatch
	end

PokemonLeague_LoreleisRoom_EventScript_Round6::
	msgbox PokemonLeague_LoreleisRoom_Text_Round6Intro
	trainerbattle_no_intro TRAINER_LEAGUE_ZEPHYR, PokemonLeague_LoreleisRoom_Text_Round6Defeat
	setvar VAR_TOURNAMENT_ROUND, 7
	goto PokemonLeague_LoreleisRoom_EventScript_NextMatch
	end

PokemonLeague_LoreleisRoom_EventScript_Round7::
	msgbox PokemonLeague_LoreleisRoom_Text_Round7Intro
	trainerbattle_no_intro TRAINER_LEAGUE_BLUE, PokemonLeague_LoreleisRoom_Text_Round7Defeat
	setvar VAR_TOURNAMENT_ROUND, 8
	goto PokemonLeague_LoreleisRoom_EventScript_NextMatch
	end

PokemonLeague_LoreleisRoom_EventScript_Round8::
	msgbox PokemonLeague_LoreleisRoom_Text_Round8Intro
	trainerbattle_no_intro TRAINER_LEAGUE_N, PokemonLeague_LoreleisRoom_Text_Round8Defeat
	setvar VAR_TOURNAMENT_ROUND, 9
	goto PokemonLeague_LoreleisRoom_EventScript_TournamentWon
	end

PokemonLeague_LoreleisRoom_EventScript_NextMatch::
	msgbox PokemonLeague_LoreleisRoom_Text_NextMatch
	closemessage
	special HealPlayerParty
	fadescreen FADE_TO_BLACK
	warp MAP_POKEMON_LEAGUE_LORELEIS_ROOM, 6, 10
	waitstate
	end

@ Topaze: end of the bracket. The way to the CHAMPION's room opens.
PokemonLeague_LoreleisRoom_EventScript_TournamentWon::
	setflag FLAG_DEFEATED_LORELEI
	call PokemonLeague_EventScript_OpenDoor
	special HealPlayerParty
	msgbox PokemonLeague_LoreleisRoom_Text_TournamentWon
	release
	end
