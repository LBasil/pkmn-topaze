VictoryRoad_1F_Text_NaomiIntro::
    .string "I am the road's NURSE. But only\n"
    .string "trainers who can fight get my care.\p"
    .string "Show me what you have!$"

VictoryRoad_1F_Text_NaomiDefeat::
    .string "Impressive. You have earned it.$"

VictoryRoad_1F_Text_NaomiHeal::
    .string "Come, let me patch up your\n"
    .string "POKéMON. Talk to me any time.$"

VictoryRoad_1F_Text_NaomiHealed::
    .string "All better! Go on. The LEAGUE\n"
    .string "is waiting.$"

VictoryRoad_1F_Text_RolandoIntro::
    .string "The League road belongs to us!$"

VictoryRoad_1F_Text_RolandoDefeat::
    .string "Burned out.$"

VictoryRoad_1F_Text_RolandoPostBattle::
    .string "The MASTER is ahead. RED went\n"
    .string "in before you. Alone.$"

