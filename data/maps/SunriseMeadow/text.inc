SunriseMeadow_Text_ReturnAsk::
	.string "Ready to go back to the dock?$"

SunriseMeadow_Text_Stay::
	.string "Take your time. The tide can wait.$"

SunriseMeadow_Text_Npc0::
	.string "The sun comes up here before\n"
	.string "anywhere else.$"

SunriseMeadow_Text_Npc1::
	.string "MAREEP and HOPPIP love the morning\n"
	.string "dew.$"

SunriseMeadow_Text_Quest0_Ask::
	.string "A STAR PIECE glints like the\n"
	.string "morning. Find me one, I will pay in\p"
	.string "luck.$"

SunriseMeadow_Text_Quest0_Done::
	.string "It shines! Take this LUCKY EGG.$"

SunriseMeadow_Text_Quest0_AfterT::
	.string "The meadow shines brighter today.$"

SunriseMeadow_Text_Quest0_MissT::
	.string "No STAR PIECE yet. Try digging in\n"
	.string "the mine.$"

SunriseMeadow_Text_Quest0_NoRoomT::
	.string "Your BAG is full. Make room, then\n"
	.string "come back.$"

SunriseMeadow_Text_Gift0_Offer::
	.string "A little egg hatched on this\n"
	.string "meadow. It needs a friend. Will you\p"
	.string "take it?$"

SunriseMeadow_Text_Gift0_Got::
	.string "Please look after it.$"

SunriseMeadow_Text_Gift0_After::
	.string "I hope it is happy with you.$"

SunriseMeadow_Text_Gift0_Refuse::
	.string "Then I will keep it a little\n"
	.string "longer.$"

