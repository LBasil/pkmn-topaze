ReflectionMarsh_Text_ReturnAsk::
	.string "Ready to go back to the dock?$"

ReflectionMarsh_Text_Stay::
	.string "Take your time. The tide can wait.$"

ReflectionMarsh_Text_Npc0::
	.string "Everything here looks like another\n"
	.string "POKéMON, before or after.$"

ReflectionMarsh_Text_Npc1::
	.string "I caught an EEVEE here. It would\n"
	.string "not stop looking at its reflection.$"

ReflectionMarsh_Text_Radar0::
	.string "I track rare POKéMON. Today my\n"
	.string "radar says...$"

ReflectionMarsh_Text_Radar1::
	.string "FEEBAS bites in the quiet water of\n"
	.string "the POND OF CYCLES, by fishing.$"

ReflectionMarsh_Text_Radar2::
	.string "AERODACTYL is sighted in the FOSSIL\n"
	.string "DIG, among the rocks.$"

ReflectionMarsh_Text_Radar3::
	.string "DRATINI hides under the water of\n"
	.string "the POND and the TRADE DOCK.$"
