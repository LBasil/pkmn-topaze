SaffronCity_HomeB_Text_Letter::
	.string "A letter just arrived for you,\n"
	.string "{PLAYER}. It is dated... tomorrow.\p"
	.string "The handwriting is yours.$"

SaffronCity_HomeB_Text_Read::
	.string "It reads: THE FERRYMAN AT\n"
	.string "AMETHIOLITE KNOWS WHERE TIME RUNS\p"
	.string "ELSEWHERE. ASK HIM. Signed: you.$"

SaffronCity_HomeB_Text_Done::
	.string "No more letters today. Or\n"
	.string "yesterday. Or tomorrow.$"

SaffronCity_HomeB_Text_NoRoom::
	.string "Your BAG is full. Make room, then\n"
	.string "come back.$"

SaffronCity_HomeB_Text_None::
	.string "No mail for you yet. Odd. The\n"
	.string "postman says letters are arriving\p"
	.string "before they are written.$"
