.equ RECEIVED_TOWN_MAP, VAR_TEMP_1

PalletTown_RivalsHouse_MapScripts::
	map_script MAP_SCRIPT_ON_TRANSITION, PalletTown_RivalsHouse_OnTransition
	map_script MAP_SCRIPT_ON_FRAME_TABLE, PalletTown_RivalsHouse_OnFrame
	.byte 0

PalletTown_RivalsHouse_OnFrame::
	map_script_2 VAR_GRENALUX_OPENING, 1, PalletTown_RivalsHouse_EventScript_OpeningScene
	.2byte 0

@ Topaze: opening scene at the RANCH. Calm talk -> ONYBRIS raid -> urgent starter choice -> battle -> MOM and the pendant
PalletTown_RivalsHouse_EventScript_OpeningScene::
	lockall
	textcolor NPC_TEXT_COLOR_MALE
	applymovement LOCALID_PLAYER, PalletTown_RivalsHouse_Movement_PlayerWalkIn
	waitmovement 0
	applymovement LOCALID_RANCH_RIVAL, Common_Movement_WalkInPlaceFasterLeft
	waitmovement 0
	msgbox PalletTown_Text_RanchDadHello
	applymovement LOCALID_RANCH_OAK, Common_Movement_WalkInPlaceFasterDown
	waitmovement 0
	msgbox PalletTown_Text_RanchOakIntro
	closemessage
	playse SE_PIN
	delay 40
	msgbox PalletTown_Text_RanchTrackersHowl
	closemessage
	clearflag FLAG_HIDE_RANCH_GRUNT
	addobject LOCALID_RANCH_GRUNT
	playse SE_EXIT
	applymovement LOCALID_PLAYER, Common_Movement_WalkInPlaceFasterLeft
	waitmovement 0
	msgbox PalletTown_Text_RanchGruntEnter
	closemessage
	msgbox PalletTown_Text_RanchDadFlees
	closemessage
	applymovement LOCALID_RANCH_FATHER, PalletTown_RivalsHouse_Movement_FatherRunsOut
	waitmovement 0
	removeobject LOCALID_RANCH_FATHER
	applymovement LOCALID_RANCH_OAK, Common_Movement_ExclamationMark
	waitmovement 0
	msgbox PalletTown_Text_RanchOakPanic
	closemessage
PalletTown_RivalsHouse_EventScript_ChooseStarter::
	message PalletTown_Text_RanchOakChoose
	waitmessage
	multichoice 0, 0, MULTICHOICE_TOPAZE_STARTER, FALSE
	goto_if_ge VAR_RESULT, 3, PalletTown_RivalsHouse_EventScript_ChooseStarter
	copyvar VAR_TEMP_2, VAR_RESULT
	goto_if_eq VAR_TEMP_2, 0, PalletTown_RivalsHouse_EventScript_StarterIsBulbasaur
	goto_if_eq VAR_TEMP_2, 1, PalletTown_RivalsHouse_EventScript_StarterIsSquirtle
	goto PalletTown_RivalsHouse_EventScript_StarterIsCharmander
	end

PalletTown_RivalsHouse_EventScript_StarterIsBulbasaur::
	setvar VAR_TEMP_3, SPECIES_BULBASAUR
	showmonpic SPECIES_BULBASAUR, 10, 3
	msgbox PalletTown_ProfessorOaksLab_Text_OakChoosingBulbasaur, MSGBOX_YESNO
	goto PalletTown_RivalsHouse_EventScript_ConfirmStarter
	end

PalletTown_RivalsHouse_EventScript_StarterIsSquirtle::
	setvar VAR_TEMP_3, SPECIES_SQUIRTLE
	showmonpic SPECIES_SQUIRTLE, 10, 3
	msgbox PalletTown_ProfessorOaksLab_Text_OakChoosingSquirtle, MSGBOX_YESNO
	goto PalletTown_RivalsHouse_EventScript_ConfirmStarter
	end

PalletTown_RivalsHouse_EventScript_StarterIsCharmander::
	setvar VAR_TEMP_3, SPECIES_CHARMANDER
	showmonpic SPECIES_CHARMANDER, 10, 3
	msgbox PalletTown_ProfessorOaksLab_Text_OakChoosingCharmander, MSGBOX_YESNO
	goto PalletTown_RivalsHouse_EventScript_ConfirmStarter
	end

PalletTown_RivalsHouse_EventScript_ConfirmStarter::
	goto_if_eq VAR_RESULT, NO, PalletTown_RivalsHouse_EventScript_DeclinedStarter
	hidemonpic
	msgbox PalletTown_ProfessorOaksLab_Text_OakThisMonIsEnergetic
	call EventScript_RestorePrevTextColor
	setflag FLAG_SYS_POKEMON_GET
	setflag FLAG_PALLET_LADY_NOT_BLOCKING_SIGN
	givemon VAR_TEMP_3, 5
	copyvar VAR_STARTER_MON, VAR_TEMP_2
	bufferspeciesname STR_VAR_1, VAR_TEMP_3
	message PalletTown_ProfessorOaksLab_Text_ReceivedMonFromOak
	waitmessage
	playfanfare MUS_OBTAIN_KEY_ITEM
	waitfanfare
	msgbox Text_GiveNicknameToThisMon, MSGBOX_YESNO
	goto_if_eq VAR_RESULT, NO, PalletTown_RivalsHouse_EventScript_AfterStarter
	setvar VAR_0x8004, 0
	call EventScript_ChangePokemonNickname
	goto PalletTown_RivalsHouse_EventScript_AfterStarter
	end

PalletTown_RivalsHouse_EventScript_DeclinedStarter::
	hidemonpic
	goto PalletTown_RivalsHouse_EventScript_ChooseStarter
	end

PalletTown_RivalsHouse_EventScript_AfterStarter::
	closemessage
	msgbox PalletTown_Text_RanchRivalTakes
	closemessage
	msgbox PalletTown_Text_RanchGruntChallenge
	closemessage
	trainerbattle_earlyrival TRAINER_TEAM_ROCKET_GRUNT_22, RIVAL_BATTLE_TUTORIAL, PalletTown_Text_OnybrisGruntDefeat, PalletTown_Text_OnybrisGruntVictory
	special HealPlayerParty
	msgbox PalletTown_Text_RanchGruntRetreat
	closemessage
	applymovement LOCALID_RANCH_GRUNT, PalletTown_RivalsHouse_Movement_GruntLeaves
	waitmovement 0
	removeobject LOCALID_RANCH_GRUNT
	setflag FLAG_HIDE_RANCH_GRUNT
	msgbox PalletTown_Text_RanchOakAfter
	closemessage
	fadescreen FADE_TO_BLACK
	removeobject LOCALID_RANCH_OAK
	removeobject LOCALID_RANCH_RIVAL
	setflag FLAG_HIDE_RANCH_SCENE
	delay 30
	clearflag FLAG_HIDE_RANCH_MOM
	addobject LOCALID_RANCH_MOM
	fadescreen FADE_FROM_BLACK
	applymovement LOCALID_RANCH_MOM, PalletTown_RivalsHouse_Movement_MomRunsIn
	applymovement LOCALID_PLAYER, Common_Movement_WalkInPlaceFasterDown
	waitmovement 0
	msgbox PalletTown_Text_RanchMom1
	closemessage
	giveitem_msg PalletTown_Text_ReceivedPendant, ITEM_RUBY, 1, MUS_OBTAIN_KEY_ITEM
	msgbox PalletTown_Text_RanchMom2
	closemessage
	fadescreen FADE_TO_BLACK
	removeobject LOCALID_RANCH_MOM
	setflag FLAG_HIDE_RANCH_MOM
	@ the raid hits the whole town: ranch, school and lab
	setflag FLAG_GRENALUX_ONYBRIS_STRIKE
	setflag FLAG_HIDE_BULBASAUR_BALL
	setflag FLAG_HIDE_SQUIRTLE_BALL
	setflag FLAG_HIDE_CHARMANDER_BALL
	setflag FLAG_HIDE_RIVAL_IN_LAB
	setvar VAR_GRENALUX_OPENING, 2
	fadescreen FADE_FROM_BLACK
	releaseall
	end

PalletTown_RivalsHouse_Movement_FatherRunsOut::
	walk_left
	walk_down
	walk_down
	walk_down
	step_end

PalletTown_RivalsHouse_Movement_GruntLeaves::
	walk_down
	walk_down
	step_end

PalletTown_RivalsHouse_Movement_MomRunsIn::
	walk_up
	walk_up
	walk_in_place_faster_right
	step_end

PalletTown_RivalsHouse_Movement_PlayerWalkIn::
	walk_up
	walk_up
	walk_right
	walk_in_place_faster_right
	step_end

PalletTown_RivalsHouse_OnTransition::
	call_if_eq VAR_GRENALUX_OPENING, 1, PalletTown_RivalsHouse_EventScript_ShowOpeningNpcs
	call_if_ne VAR_GRENALUX_OPENING, 1, PalletTown_RivalsHouse_EventScript_HideOpeningNpcs
	call_if_lt VAR_MAP_SCENE_PALLET_TOWN_RIVALS_HOUSE, 2, PalletTown_RivalsHouse_EventScript_MoveDaisyToTable
	call_if_ge VAR_MAP_SCENE_PALLET_TOWN_RIVALS_HOUSE, 2, PalletTown_RivalsHouse_EventScript_AlreadyReceivedTownMap
	end

PalletTown_RivalsHouse_EventScript_MoveDaisyToTable::
	setobjectmovementtype LOCALID_DAISY, MOVEMENT_TYPE_FACE_RIGHT
	setobjectxyperm LOCALID_DAISY, 5, 4
	return

PalletTown_RivalsHouse_EventScript_AlreadyReceivedTownMap::
	setvar RECEIVED_TOWN_MAP, TRUE
	return

PalletTown_RivalsHouse_EventScript_Daisy::
	lock
	faceplayer
	famechecker FAMECHECKER_DAISY, FCPICKSTATE_COLORED, UpdatePickStateFromSpecialVar8005
	goto_if_set FLAG_SYS_GAME_CLEAR, PalletTown_RivalsHouse_EventScript_GroomMon
	goto_if_eq RECEIVED_TOWN_MAP, TRUE, PalletTown_RivalsHouse_EventScript_PleaseGiveMonsRest
	goto_if_eq VAR_MAP_SCENE_PALLET_TOWN_RIVALS_HOUSE, 2, PalletTown_RivalsHouse_EventScript_ExplainTownMap
	goto_if_eq VAR_MAP_SCENE_PALLET_TOWN_RIVALS_HOUSE, 1, PalletTown_RivalsHouse_EventScript_GiveTownMap
	goto_if_ge VAR_MAP_SCENE_PALLET_TOWN_PROFESSOR_OAKS_LAB, 1, PalletTown_RivalsHouse_EventScript_HeardBattledRival
	msgbox PalletTown_RivalsHouse_Text_HiBrothersAtLab
	closemessage
	applymovement LOCALID_DAISY, Common_Movement_FaceOriginalDirection
	waitmovement 0
	release
	end

PalletTown_RivalsHouse_EventScript_HeardBattledRival::
	goto_if_set FLAG_GRENALUX_ONYBRIS_STRIKE, PalletTown_RivalsHouse_EventScript_DaisyStrike
	msgbox PalletTown_RivalsHouse_Text_HeardYouBattledRival
	release
	end

PalletTown_RivalsHouse_EventScript_DaisyStrike::
	msgbox PalletTown_RivalsHouse_Text_DaisyStrike
	release
	end

PalletTown_RivalsHouse_EventScript_GroomMon::
	goto_if_questlog EventScript_ReleaseEnd
	special QuestLog_CutRecording
	goto_if_lt VAR_MASSAGE_COOLDOWN_STEP_COUNTER, 500, PalletTown_RivalsHouse_EventScript_RateMonFriendship
	msgbox PalletTown_RivalsHouse_Text_LikeMeToGroomMon, MSGBOX_YESNO
	goto_if_eq VAR_RESULT, NO, PalletTown_RivalsHouse_EventScript_DeclineGrooming
	msgbox PalletTown_RivalsHouse_Text_GroomWhichOne
	special ChoosePartyMon
	waitstate
	lock
	faceplayer
	goto_if_ge VAR_0x8004, PARTY_SIZE, PalletTown_RivalsHouse_EventScript_DeclineGrooming
	specialvar VAR_RESULT, GetPartyMonSpecies
	goto_if_eq VAR_RESULT, SPECIES_EGG, PalletTown_RivalsHouse_EventScript_CantGroomEgg
	msgbox PalletTown_RivalsHouse_Text_LookingNiceInNoTime
	closemessage
	fadescreen FADE_TO_BLACK
	playfanfare MUS_HEAL
	waitfanfare
	special DaisyMassageServices
	fadescreen FADE_FROM_BLACK
	special BufferMonNickname
	msgbox PalletTown_RivalsHouse_Text_ThereYouGoAllDone
	release
	end

PalletTown_RivalsHouse_EventScript_CantGroomEgg::
	msgbox PalletTown_RivalsHouse_Text_CantGroomAnEgg
	release
	end

PalletTown_RivalsHouse_EventScript_DeclineGrooming::
	msgbox PalletTown_RivalsHouse_Text_DontNeedAnyGrooming
	release
	end

PalletTown_RivalsHouse_EventScript_RateMonFriendship::
	msgbox PalletTown_RivalsHouse_Text_MayISeeFirstMon
	specialvar VAR_RESULT, GetLeadMonFriendship
	switch VAR_RESULT
	case 0, PalletTown_RivalsHouse_EventScript_MonFriendshipLowest
	case 1, PalletTown_RivalsHouse_EventScript_MonFriendshipLower
	case 2, PalletTown_RivalsHouse_EventScript_MonFriendshipLow
	case 3, PalletTown_RivalsHouse_EventScript_MonFriendshipMid
	case 4, PalletTown_RivalsHouse_EventScript_MonFriendshipHigh
	case 5, PalletTown_RivalsHouse_EventScript_MonFriendshipHigher
	case 6, PalletTown_RivalsHouse_EventScript_MonFriendshipHighest
	end

PalletTown_RivalsHouse_EventScript_MonFriendshipLowest::
	msgbox PalletTown_RivalsHouse_Text_WhyWouldMonHateYouSoMuch
	release
	end

PalletTown_RivalsHouse_EventScript_MonFriendshipLower::
	msgbox PalletTown_RivalsHouse_Text_DontLikeWayItGlaresAtYou
	release
	end

PalletTown_RivalsHouse_EventScript_MonFriendshipLow::
	msgbox PalletTown_RivalsHouse_Text_NotFamiliarWithYouYet
	release
	end

PalletTown_RivalsHouse_EventScript_MonFriendshipMid::
	msgbox PalletTown_RivalsHouse_Text_ItsWarmingUpToYou
	release
	end

PalletTown_RivalsHouse_EventScript_MonFriendshipHigh::
	msgbox PalletTown_RivalsHouse_Text_ItsQuiteFriendly
	release
	end

PalletTown_RivalsHouse_EventScript_MonFriendshipHigher::
	msgbox PalletTown_RivalsHouse_Text_ItLooksVeryHappy
	release
	end

PalletTown_RivalsHouse_EventScript_MonFriendshipHighest::
	msgbox PalletTown_RivalsHouse_Text_CouldntLoveYouMore
	release
	end

PalletTown_RivalsHouse_EventScript_PleaseGiveMonsRest::
	msgbox PalletTown_RivalsHouse_Text_PleaseGiveMonsRest
	release
	end

PalletTown_RivalsHouse_EventScript_GiveTownMap::
	msgbox PalletTown_RivalsHouse_Text_ErrandForGrandpaThisWillHelp
	closemessage
	checkitemspace ITEM_TOWN_MAP
	goto_if_eq VAR_RESULT, FALSE, PalletTown_RivalsHouse_EventScript_NoRoomForTownMap
	applymovement LOCALID_DAISY, Common_Movement_WalkInPlaceFasterRight
	waitmovement 0
	removeobject LOCALID_TOWN_MAP
	setvar VAR_MAP_SCENE_PALLET_TOWN_RIVALS_HOUSE, 2
	delay 15
	applymovement LOCALID_DAISY, Common_Movement_FacePlayer
	waitmovement 0
	delay 12
	giveitem_msg PalletTown_RivalsHouse_Text_ReceivedTownMapFromDaisy, ITEM_TOWN_MAP, 1, MUS_OBTAIN_KEY_ITEM
	release
	end

PalletTown_RivalsHouse_EventScript_NoRoomForTownMap::
	msgbox PalletTown_RivalsHouse_Text_DontHaveSpaceForThis
	release
	end

PalletTown_RivalsHouse_EventScript_ExplainTownMap::
	msgbox PalletTown_RivalsHouse_Text_ExplainTownMap
	release
	end

PalletTown_RivalsHouse_EventScript_TownMap::
	msgbox PalletTown_RivalsHouse_Text_ItsBigMapOfKanto, MSGBOX_NPC
	end

PalletTown_RivalsHouse_EventScript_Bookshelf::
	msgbox PalletTown_RivalsHouse_Text_ShelvesCrammedFullOfBooks, MSGBOX_SIGN
	end

PalletTown_RivalsHouse_EventScript_Picture::
	msgbox PalletTown_RivalsHouse_Text_LovelyAndSweetClefairy, MSGBOX_SIGN
	end

PalletTown_RivalsHouse_EventScript_ShowOpeningNpcs::
	clearflag FLAG_HIDE_RANCH_SCENE
	setflag FLAG_HIDE_RANCH_GRUNT
	setflag FLAG_HIDE_RANCH_MOM
	return

PalletTown_RivalsHouse_EventScript_HideOpeningNpcs::
	setflag FLAG_HIDE_RANCH_SCENE
	setflag FLAG_HIDE_RANCH_GRUNT
	setflag FLAG_HIDE_RANCH_MOM
	return
