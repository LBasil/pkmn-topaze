NoTomorrowVillage_Text_ReturnAsk::
	.string "Ready to go back to the dock?$"

NoTomorrowVillage_Text_Stay::
	.string "Take your time. The tide can wait.$"

NoTomorrowVillage_Text_Boss_Intro::
	.string "Today again. It was a good day, so\n"
	.string "it stayed. Break it, if you can!$"

NoTomorrowVillage_Text_Boss_Defeat::
	.string "So tomorrow finally... arrives.$"

NoTomorrowVillage_Text_Boss_After::
	.string "The sun is rising. Really rising.\n"
	.string "Thank you.$"

NoTomorrowVillage_Text_Boss_NoRoom::
	.string "Your BAG is full. Make room, then\n"
	.string "come back.$"

NoTomorrowVillage_Text_Npc0::
	.string "Good morning! Good morning! It is\n"
	.string "always morning here.$"

NoTomorrowVillage_Text_Npc0_A::
	.string "Good evening! Evening! It is\n"
	.string "evening!$"

NoTomorrowVillage_Text_Npc1::
	.string "I bought bread yesterday. Today I\n"
	.string "bought it again. Same bread.$"

NoTomorrowVillage_Text_Npc1_A::
	.string "Fresh bread, today. A new loaf. How\n"
	.string "strange!$"

NoTomorrowVillage_Text_Npc2::
	.string "Mama says tomorrow never comes. I\n"
	.string "think it is hiding.$"

NoTomorrowVillage_Text_Npc2_A::
	.string "Mama says tomorrow came. I told you\n"
	.string "it was hiding.$"
