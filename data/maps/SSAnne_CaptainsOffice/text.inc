SSAnne_CaptainsOffice_Text_CaptainIFeelSeasick::
    .string "CAPTAIN: Ooargh…\n"
    .string "I feel hideous…\l"
    .string "Urrp! Seasick…$"

SSAnne_CaptainsOffice_Text_RubbedCaptainsBack::
    .string "{PLAYER} rubbed the CAPTAIN's\n"
    .string "back!\p"
    .string "Rub-rub…\n"
    .string "Rub-rub…$"

SSAnne_CaptainsOffice_Text_ThankYouHaveHMForCut::
    .string "CAPTAIN: Whew! Thank you!\n"
    .string "I'm feeling much better now.\p"
    .string "Those men in black wanted the\n"
    .string "APATITE HERA lent me for the gala.\p"
    .string "I hid it in my safe, and you\n"
    .string "arrived just in time! Splendid!\p"
    .string "They'll flee by speedboat to the\n"
    .string "SEVII ISLANDS, I bet.\p"
    .string "Here, a HIDDEN MACHINE as thanks.\n"
    .string "Teach CUT to your POKéMON, and\l"
    .string "chop down small trees!\p"
    .string "I'll return the APATITE to HERA\n"
    .string "myself. Go and challenge her!$"

SSAnne_CaptainsOffice_Text_ObtainedHM01FromCaptain::
    .string "{PLAYER} obtained HM01\n"
    .string "from the CAPTAIN!$"

SSAnne_CaptainsOffice_Text_ExplainCut::
    .string "Using CUT, you can chop down\n"
    .string "small trees.\p"
    .string "A small tree blocks the pass east\n"
    .string "of TOURMALIA. That way leads to\l"
    .string "ROCK TUNNEL and SPINELLIA.$"

SSAnne_CaptainsOffice_Text_SSAnneWillSetSailSoon::
    .string "CAPTAIN: …Whew!\p"
    .string "Now that I'm not sick anymore,\n"
    .string "I guess it's time.\p"
    .string "The S.S. ANNE will set sail soon!\p"
    .string "Farewell, until our return to\n"
    .string "APATIA!$"

SSAnne_CaptainsOffice_Text_YouHaveNoRoomForThis::
    .string "Oh, no!\n"
    .string "You have no room for this!$"

SSAnne_CaptainsOffice_Text_YuckShouldntHaveLooked::
    .string "Yuck!\n"
    .string "Shouldn't have looked!$"

SSAnne_CaptainsOffice_Text_HowToConquerSeasickness::
    .string "How to Conquer Seasickness…\n"
    .string "The CAPTAIN's reading this!$"


SSAnne_CaptainsOffice_Text_VesperIntro::
    .string "VESPER: The APATITE belongs to\n"
    .string "TEAM ZIRCON now, old man.\p"
    .string "A child? HERA and her friend are\n"
    .string "busy outside, so you will do.\p"
    .string "I am VESPER, one of the boss's\n"
    .string "chosen. Do not disappoint me!$"

SSAnne_CaptainsOffice_Text_VesperDefeat::
    .string "Impossible... I lost to a mere\n"
    .string "child?$"

SSAnne_CaptainsOffice_Text_VesperPostBattle::
    .string "VESPER: The boss was right to\n"
    .string "watch you. We have the chart of\l"
    .string "the SEVII ISLANDS anyway.\p"
    .string "Next time, the gems are ours.\n"
    .string "Farewell!$"
