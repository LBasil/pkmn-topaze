EchoGarden_Text_ReturnAsk::
	.string "Ready to go back to the dock?$"

EchoGarden_Text_Stay::
	.string "Take your time. The tide can wait.$"

EchoGarden_Text_Boss_Intro::
	.string "Every flower here grew from an\n"
	.string "ECHO. Please do not trample them.\p"
	.string "Battle me instead!$"

EchoGarden_Text_Boss_Defeat::
	.string "Oh! The flowers are cheering for\n"
	.string "you.$"

EchoGarden_Text_Boss_After::
	.string "Come back in spring. Or any time.\n"
	.string "It is always spring here.$"

EchoGarden_Text_Boss_NoRoom::
	.string "Your BAG is full. Make room, then\n"
	.string "come back.$"

EchoGarden_Text_Npc0::
	.string "These seeds fell from ECHOES. I\n"
	.string "water them with sea air.$"

EchoGarden_Text_Npc1::
	.string "Do not pick the blue ones. They\n"
	.string "remember too much.$"
