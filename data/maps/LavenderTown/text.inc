LavenderTown_Text_TownKnownAsMonGraveSite::
    .string "The SPINEL that rested in the\n"
    .string "TOWER's crypt was stolen last\p"
    .string "night. Men in black, they say.\n"
    .string "The TOWER's keeper is missing!$"

LavenderTown_Text_GhostsAppearedInTower::
    .string "Ghosts appeared in POKéMON TOWER.\p"
    .string "I think they're the spirits of\n"
    .string "POKéMON that the ONYBRIS killed.$"

LavenderTown_Text_TownSign::
    .string "SPINELLIA\n"
    .string "The Spinel Tower Town$"

LavenderTown_Text_PoliceClosed::
    .string "POLICEMAN: The SPINEL was stolen\n"
    .string "from the TOWER, and its keeper is\p"
    .string "missing. Nobody leaves SPINELLIA\n"
    .string "until we find him. Try the TOWER.$"

LavenderTown_Text_PoliceOpen::
    .string "POLICEMAN: The keeper is safe, we\n"
    .string "heard. The roads are open again.\p"
    .string "The thieves went toward the big\n"
    .string "cities. Be careful out there!$"

